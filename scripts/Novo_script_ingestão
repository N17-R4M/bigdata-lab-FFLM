import pandas as pd
from pymongo import MongoClient
import datetime

# --- CONFIGURAÇÕES ---
# 1. Cole aqui o link que você copiou do Atlas
# Troque <password> pela senha que você criou no passo anterior
# Se não lembra a senha, vá em "Database Access" no menu lateral e clique em "Edit" no usuário.
MONGO_URI = "mongodb+srv://usuario:sua_senha@projetomba.xxxx.mongodb.net/?retryWrites=true&w=majority"

# 2. Link da sua fonte de dados (Vou usar um exemplo, troque pelo seu link real)
URL_CSV = "https://raw.githubusercontent.com/datasciencedojo/datasets/master/titanic.csv"

def ingestao_bronze():
    try:
        print("📥 Iniciando extração dos dados...")
        df = pd.read_csv(URL_CSV)
        
        # Adicionando metadados (Engenharia de Dados raiz!)
        # Isso prova para o seu professor que você se preocupa com a linhagem do dado
        df['dt_ingestao'] = datetime.datetime.now()
        df['fonte'] = URL_CSV

        # Conectando ao Atlas
        client = MongoClient(MONGO_URI)
        db = client['MBA_Engenharia_Dados'] # Nome do Banco
        bronze = db['camada_bronze']       # Nome da Coleção (Tabela)

        # Limpa a coleção antes de inserir (Para não duplicar se você rodar o script 2x)
        bronze.delete_many({}) 

        # Transformando para o formato que o Mongo gosta (JSON/Dicionário)
        registros = df.to_dict(orient='records')
        
        # Enviando!
        bronze.insert_many(registros)
        
        print(f"✅ Sucesso! {len(registros)} registros enviados para a camada BRONZE.")
        print(f"Consulte no Atlas em: Browse Collections -> MBA_Engenharia_Dados")

    except Exception as e:
        print(f"❌ Erro na extração: {e}")

if __name__ == "__main__":
    ingestao_bronze()
